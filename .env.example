# Copy to .env and fill in real values locally. Never commit .env.

# ENVIRONMENT: `local` or `dev` enable the interactive API docs (/docs, /redoc,
# /openapi.json) and allow a non-https SUPABASE_URL (a local Supabase stack).
# ANY other value -- production, staging, or a typo -- is treated as
# production-like: docs are disabled and SUPABASE_URL must be https.
ENVIRONMENT=local

# Supabase. SUPABASE_URL is used by the backend to derive the JWT issuer and
# JWKS URL. The publishable key (current terminology; replaces the legacy
# "anon key") is safe for client code. The Flutter app does not read this
# file — see mobile/config/dev.example.json for the mobile-side equivalent.
# The backend-only secret key is a separate variable, below.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Phase 12, backend-only -- current Supabase secret-key model (sb_secret_...,
# replaces the legacy service_role key), used solely by DELETE /account to
# call the Supabase Auth Admin API. Never the mobile client's key, never
# committed with a real value, never referenced from mobile/config/*.
# Optional: the backend still starts normally without it -- only
# DELETE /account degrades to a 503 ("not configured") in that case.
SUPABASE_SECRET_KEY=

# Backend, Phase 3+ -- direct Postgres connections, backend-only, never
# referenced from mobile/config/*. Two distinct roles/credentials, never
# the same value -- see docs/DATABASE.md.
#
# DATABASE_URL: the running FastAPI app's connection, as the dedicated
# least-privilege `beerapp_backend` role (SELECT only on the catalog
# tables). Session Pooler (port 5432) unless this deployment has Direct
# Connection or the Supabase IPv4 add-on -- never Transaction Pooler (port
# 6543) for this persistent backend; see docs/DATABASE.md.
DATABASE_URL=

# SEED_DATABASE_URL: backend/scripts/seed_catalog.py only, as the
# write-capable `beerapp_seed` role. Never read by the running API (it is
# deliberately not declared in app/config.py's Settings).
SEED_DATABASE_URL=

# INTEGRATION_DATABASE_URL: opt-in only, for `pytest -m integration`
# (backend/tests/integration/). Must point at a DISPOSABLE database (a local
# Supabase stack or local Postgres) -- never the dev project, never
# production. Most of those tests roll back, but several commit real rows and
# clean up, so the target must be one nobody else depends on. The suite
# refuses to run if this equals DATABASE_URL / SEED_DATABASE_URL, shares their
# host, or is not a loopback host (set INTEGRATION_DATABASE_ALLOW_REMOTE=1
# only for a dedicated hosted test database). See docs/DATABASE.md.
INTEGRATION_DATABASE_URL=

# Optional backend tuning -- defaults shown; omit unless you need to change them.
# JWT_AUDIENCE=authenticated
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_STATEMENT_CACHE_SIZE=100   # must be 0 behind a Transaction Pooler (port 6543)
#
# Timeouts (seconds). A slow or saturated database fails fast and is reported
# to clients as a sanitized 503 instead of hanging the request.
# DB_CONNECT_TIMEOUT_SECONDS=10   # opening a new connection
# DB_ACQUIRE_TIMEOUT_SECONDS=10   # waiting for a free pooled connection
# DB_COMMAND_TIMEOUT_SECONDS=30   # any single statement
#
# JWKS (Supabase signing keys): a cached key set is trusted for at most the TTL,
# and refreshes (unknown key id, or a failed load) happen at most once per cooldown.
# JWKS_CACHE_TTL_SECONDS=600
# JWKS_REFRESH_COOLDOWN_SECONDS=30
#
# Largest accepted request body, in bytes (413 above it). Legitimate bodies are
# a few KB; 64 KiB leaves generous headroom.
# MAX_REQUEST_BODY_BYTES=65536
#
# Log level for the app's own logs: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Request lines never include the query string, bodies, tokens or secrets.
# LOG_LEVEL=INFO
