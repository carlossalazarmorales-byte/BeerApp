# Copy to .env and fill in real values locally. Never commit .env.
# No real Supabase project exists yet — these names document the shape
# expected once Phase 2+ wires up the database/auth.

# Backend
ENVIRONMENT=local
API_BASE_URL=http://localhost:8000

# Supabase (server-side only — service role key must never reach the mobile client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=
