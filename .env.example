# Copy to .env and fill in real values locally. Never commit .env.

ENVIRONMENT=local
API_BASE_URL=http://localhost:8000

# Supabase — mobile client only in Phase 2. Uses current publishable-key
# terminology (replaces the legacy "anon key" naming). The publishable key
# is safe for client code; there is no secret/service-role key here because
# nothing in Phase 2 runs server-side Supabase calls.
# The Flutter app does not actually read this file — see
# mobile/config/dev.example.json for the mobile-side equivalent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend, Phase 3+ -- direct Postgres connections, backend-only, never
# referenced from mobile/config/*. Two distinct roles/credentials, never
# the same value -- see docs/DATABASE.md.
#
# DATABASE_URL: the running FastAPI app's connection, as the dedicated
# least-privilege `beerapp_backend` role (SELECT only on the catalog
# tables). Session Pooler (port 5432) unless this deployment has Direct
# Connection or the Supabase IPv4 add-on -- never Transaction Pooler (port
# 6543) for this persistent backend; see docs/DATABASE.md.
DATABASE_URL=

# SEED_DATABASE_URL: backend/scripts/seed_catalog.py only, as the
# write-capable `beerapp_seed` role. Never read by the running API (it is
# deliberately not declared in app/config.py's Settings).
SEED_DATABASE_URL=

# INTEGRATION_DATABASE_URL: opt-in only, for `pytest -m integration`'s
# database constraint tests (backend/tests/integration/). Must point at a
# disposable/test schema -- never DATABASE_URL or SEED_DATABASE_URL. Every
# integration test using it runs inside a rolled-back transaction, but this
# is still deliberately a separate variable so it can never be pointed at
# the real dev project by accident.
INTEGRATION_DATABASE_URL=
